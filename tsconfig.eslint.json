{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["bun", "node"],
    "paths": {
      "@ankhorage/supabase-vault": ["src/index.ts"],
      "@ankhorage/supabase-vault/migration": ["src/migration.ts"]
    }
  },
  "include": ["src/**/*.ts", "eslint.config.mjs", "paradox.config.ts"],
  "exclude": ["dist", "node_modules"]
}
